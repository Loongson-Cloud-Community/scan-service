upstream scan_results_portal {
    server scan-results-portal:8080;
    keepalive 16;
}

limit_req_zone $binary_remote_addr zone=portal_reads:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=artifact_reads:10m rate=2r/s;
limit_req_zone $binary_remote_addr zone=operator_sync:10m rate=6r/m;
limit_conn_zone $binary_remote_addr zone=portal_connections:10m;
limit_req_status 429;
limit_conn_status 429;

server {
    listen 8080;
    server_name _;
    return 308 https://$host:${PORTAL_HTTPS_PORT}$request_uri;
}

server {
    listen 8443 ssl;
    server_name _;
    server_tokens off;

    ssl_certificate /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;

    client_max_body_size 1m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # Jenkins agents call the Portal service directly on the private Compose
    # network. The public gateway never exposes the ingest endpoints.
    location = /api/v1/rpm/events {
        return 404;
    }

    location = /api/v1/srpm/events {
        return 404;
    }

    # These are the only public POST routes. The application validates the
    # operator Bearer Token before starting synchronization.
    location ~ ^/api/v1/(rpm|srpm)/sync$ {
        limit_except POST {
            deny all;
        }
        limit_req zone=operator_sync burst=2 nodelay;
        proxy_pass http://scan_results_portal;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ~ ^/api/v1/(rpm|srpm)/tasks/[0-9]+/(artifacts|archive)/ {
        limit_except GET {
            deny all;
        }
        limit_req zone=artifact_reads burst=5 nodelay;
        limit_conn portal_connections 3;
        proxy_buffering off;
        proxy_pass http://scan_results_portal;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        limit_except GET {
            deny all;
        }
        limit_req zone=portal_reads burst=40 nodelay;
        limit_conn portal_connections 10;
        proxy_pass http://scan_results_portal;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
