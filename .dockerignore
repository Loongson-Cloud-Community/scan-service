# Agent builds use the stack root to include their shared client.
# Allow only image inputs: never send .env, data volumes, Portal or Git metadata.
**
!common/
common/**
!common/install.py
!common/scan_agent_events/
!common/scan_agent_events/**
!rpm-scan-agent/
rpm-scan-agent/**
!rpm-scan-agent/Dockerfile
!rpm-scan-agent/scripts/
!rpm-scan-agent/scripts/**
!rpm-scan-agent/libexec/
!rpm-scan-agent/libexec/**
!srpm-scan-agent/
srpm-scan-agent/**
!srpm-scan-agent/Dockerfile
!srpm-scan-agent/scripts/
!srpm-scan-agent/scripts/**
# Even inside an allowed source directory, these are not image inputs.
**/.git
**/.git/**
**/.env
**/.env.*
**/__pycache__
**/*.pyc
